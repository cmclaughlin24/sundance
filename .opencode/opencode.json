{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "senior-engineer",
  "subagent_depth": 1,
  "agents": {
    "architect": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "forms-hub-gateway": {
      "type": "remote",
      "url": "http://localhost:8082/mcp",
      "enabled": true
    }
  }
}
