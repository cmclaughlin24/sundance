{
  "name": "forms-hub-gateway",
  "version": "1.0.0",
  "logLevel": "debug",
  "transport": "http",
  "port": 80,
  "targets": [
    {
      "name": "forms-api",
      "baseUrl": "http://forms",
      "spec": {
        "version": "2.0",
        "url": "http://forms/swagger/doc.json"
      },
      "headers": {
        "Authorization": "Bearer mcp-gateway-token",
        "X-Tenant-ID": "01a1731b-9014-767e-b4dd-b1445339e4c4"
      },
      "timeout": null,
      "policy": {
        "allow": [],
        "deny": ["DELETE /**", "POST /**/retire", "POST /**/deprecate"]
      }
    },
    {
      "name": "tenants-api",
      "baseUrl": "http://tenants",
      "spec": {
        "version": "2.0",
        "url": "http://tenants/swagger/doc.json"
      },
      "headers": {
        "Authorization": "Bearer mcp-gateway-token",
        "X-Tenant-ID": "01a1731b-9014-767e-b4dd-b1445339e4c4"
      },
      "timeout": null,
      "policy": {
        "allow": ["GET /**"],
        "deny": []
      }
    }
  ]
}
